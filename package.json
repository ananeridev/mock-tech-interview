{
  "name": "ticketly",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter @ticketly/api db:migrate",
    "db:seed": "pnpm --filter @ticketly/api db:seed",
    "test:challenges": "vitest run challenges",
    "test:live": "vitest run live"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "type": "module",
  "dependencies": {
    "@ticketly/shared": "workspace:*"
  }
}
